{
  "uid": "kea-dhcp",
  "title": "Kea DHCP",
  "tags": [
    "kea",
    "dhcp"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Estado de los servidores Kea",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-kea"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-kea"
          },
          "expr": "up{job=\"kea\"}",
          "legendFormat": "{{servidor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CAÍDO",
                  "color": "red"
                },
                "1": {
                  "text": "EN MARCHA",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Servidor que está respondiendo (ACK/min)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-kea"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-kea"
          },
          "expr": "sum by (servidor) (rate(kea_dhcp4_packets_sent_total{job=\"kea\",operation=\"ack\"}[5m])) * 60",
          "legendFormat": "{{servidor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "blue",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Direcciones asignadas (total)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-kea"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-kea"
          },
          "expr": "sum(max by (subnet) (kea_dhcp4_addresses_assigned_total{job=\"kea\",pool=\"\"}))",
          "legendFormat": "asignadas"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-kea"
          },
          "expr": "sum(max by (subnet) (kea_dhcp4_addresses_total{job=\"kea\",pool=\"\"}))",
          "legendFormat": "disponibles en pools"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Uso de cada pool (%)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-kea"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-kea"
          },
          "expr": "100 * max by (subnet) (kea_dhcp4_addresses_assigned_total{job=\"kea\",pool=\"\"}) / max by (subnet) (kea_dhcp4_addresses_total{job=\"kea\",pool=\"\"})",
          "legendFormat": "{{subnet}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Direcciones asignadas por subred",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-kea"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-kea"
          },
          "expr": "max by (subnet) (kea_dhcp4_addresses_assigned_total{job=\"kea\",pool=\"\"})",
          "legendFormat": "{{subnet}}"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Paquetes recibidos por tipo (paquetes/min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-kea"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-kea"
          },
          "expr": "sum by (servidor, operation) (rate(kea_dhcp4_packets_received_total{job=\"kea\",operation=~\"discover|request|release|decline|inform\"}[2m])) * 60",
          "legendFormat": "{{servidor}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Paquetes enviados por servidor (paquetes/min) — aquí se ve el failover",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-kea"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-kea"
          },
          "expr": "sum by (servidor, operation) (rate(kea_dhcp4_packets_sent_total{job=\"kea\"}[2m])) * 60",
          "legendFormat": "{{servidor}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Direcciones declinadas y recuperadas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-kea"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-kea"
          },
          "expr": "max by (subnet) (kea_dhcp4_addresses_declined_total{job=\"kea\",pool=\"\"})",
          "legendFormat": "declinadas {{subnet}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-kea"
          },
          "expr": "max by (subnet) (kea_dhcp4_addresses_reclaimed_total{job=\"kea\",pool=\"\"})",
          "legendFormat": "recuperadas {{subnet}}"
        }
      ]
    }
  ]
}